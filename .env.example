# API
PORT=3000
# Порт 5433 на хосте — 5432 часто занят другими проектами
DATABASE_URL=postgresql://hermes:hermes@localhost:5433/hermes
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# В dev без ключей Яндекса работает фейковый OAuth: AUTH_DEV_FAKE=1
AUTH_DEV_FAKE=1

# Origins
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
API_PUBLIC_URL=http://localhost:3000

# S3 (MinIO в dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hermes
S3_SECRET_KEY=hermes-secret
S3_BUCKET=lots
S3_PUBLIC_URL=http://localhost:9000/lots

# Web Push (сгенерировать: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hermes-trade.local
