{
	email {$ACME_EMAIL}
}

# Клиент покупателя — https://{DOMAIN}
{$DOMAIN} {
	encode zstd gzip

	# REST API: /api/* → NestJS (префикс срезается, как в vite-прокси)
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	# WebSocket (socket.io)
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	# Медиа из MinIO: /s3/lots/<key> → бакет lots
	handle_path /s3/* {
		# Медиа неизменяемы (ключи с uuid) — кэшируем надолго
		header Cache-Control "public, max-age=2592000, immutable"
		reverse_proxy minio:9000
	}

	# OG-превью для краулеров соцсетей: при шеринге ссылки на лот возвращаем
	# HTML с og:-метатегами (фото/название/цена). Людей это не задевает.
	@og_bot {
		header_regexp User-Agent (?i)(telegrambot|whatsapp|facebookexternalhit|vkshare|twitterbot|slackbot|discordbot|linkedinbot|skypeuripreview|googlebot)
	}
	handle @og_bot {
		@lot path_regexp lot ^/lots/([0-9a-fA-F-]+)$
		handle @lot {
			rewrite * /og/lots/{re.lot.1}
			reverse_proxy api:3000
		}
		@homepath path /
		handle @homepath {
			rewrite * /og/home
			reverse_proxy api:3000
		}
		# прочие пути ботам — обычная статика
		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
		}
	}

	# SPA: статика + fallback на index.html; service worker без кэша
	handle {
		root * /srv/web
		@sw path /sw.js /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Админка — https://admin.{DOMAIN}
admin.{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	handle /socket.io/* {
		reverse_proxy api:3000
	}

	handle_path /s3/* {
		# Медиа неизменяемы (ключи с uuid) — кэшируем надолго
		header Cache-Control "public, max-age=2592000, immutable"
		reverse_proxy minio:9000
	}

	handle {
		root * /srv/admin
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Прямая загрузка больших файлов по presigned URL.
# Важно: путь не переписывается, иначе MinIO отклонит SigV4-подпись.
s3.{$DOMAIN} {
	reverse_proxy minio:9000 {
		header_up Host {host}
	}
}
