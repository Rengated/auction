{
  "name": "hermes-trade",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @hermes/api dev",
    "dev:web": "pnpm --filter @hermes/web dev",
    "dev:admin": "pnpm --filter @hermes/admin dev",
    "build": "pnpm --filter @hermes/shared build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @hermes/api db:migrate",
    "db:seed": "pnpm --filter @hermes/api db:seed",
    "db:reset": "pnpm --filter @hermes/api db:reset"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
