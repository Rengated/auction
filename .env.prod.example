# Продакшен-окружение. Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
#   cp .env.prod.example .env

# ── Домен и TLS ────────────────────────────────────────────────────────────
# A-записи в DNS: DOMAIN и admin.DOMAIN → IP сервера. Сертификаты Caddy получит сам.
DOMAIN=auction.example.ru
ACME_EMAIL=you@example.ru

# ── Секреты (сгенерируйте: openssl rand -hex 32) ───────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=

# ── MinIO (логин/пароль хранилища медиа; наружу не торчит) ─────────────────
S3_ACCESS_KEY=hermes
S3_SECRET_KEY=

# ── Яндекс OAuth (вход ПОКУПАТЕЛЕЙ; oauth.yandex.ru → создать приложение) ───
# Один Redirect URI приложения: https://DOMAIN/api/auth/yandex/callback
# (админы/менеджеры входят по логину+паролю, не через Яндекс)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Публичный адрес API за прокси — для точного redirect_uri Яндекса. = https://DOMAIN/api
API_PUBLIC_URL=https://auction.example.ru/api

# ── Диагностика производительности ─────────────────────────────────────────
# API пишет warn-лог для HTTP-запросов медленнее SLOW_HTTP_MS и SQL-запросов
# медленнее SLOW_QUERY_MS. Для активной диагностики можно временно снизить.
SLOW_HTTP_MS=500
SLOW_QUERY_MS=250

# ── Web Push (сгенерируйте: npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.ru

# ── Telegram-прокси (если api.telegram.org недоступен с сервера, напр. РФ) ──
# Купите HTTP или SOCKS5 прокси со статическим европейским IP и авторизацией.
# Поддерживаются http(s):// и socks5://. Пусто — бот ходит в Telegram напрямую.
# TELEGRAM_PROXY=http://user:pass@ip:port
# TELEGRAM_PROXY=socks5://user:pass@ip:port

# ── Telegram-алерты и команды бота ─────────────────────────────────────────
# ID чата(ов) админов: адресаты уведомлений о входах в админку и единственные,
# кому бот отвечает на /status. Несколько ID — через запятую (узнать свой: @userinfobot).
TELEGRAM_ADMIN_CHAT_ID=441931183
# Long-polling команд (1 — вкл). Поллить getUpdates должен ровно один инстанс API.
TELEGRAM_BOT_POLLING=1
