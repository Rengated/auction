# Продакшен-окружение. Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
#   cp .env.prod.example .env

# ── Домен и TLS ────────────────────────────────────────────────────────────
# A-записи в DNS: DOMAIN и admin.DOMAIN → IP сервера. Сертификаты Caddy получит сам.
DOMAIN=auction.example.ru
ACME_EMAIL=you@example.ru
# Необязательно: адрес админки (по умолчанию admin.DOMAIN) и домен сессионных куки
# (по умолчанию .DOMAIN). Если клиент и админка на соседних поддоменах одного домена —
# укажите их общий родительский, например:
#   DOMAIN=hermes.example.ru
#   ADMIN_DOMAIN=admin.example.ru
#   COOKIE_DOMAIN=.example.ru
#ADMIN_DOMAIN=
#COOKIE_DOMAIN=

# ── Секреты (сгенерируйте: openssl rand -hex 32) ───────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=

# ── MinIO (логин/пароль хранилища медиа; наружу не торчит) ─────────────────
S3_ACCESS_KEY=hermes
S3_SECRET_KEY=

# ── Яндекс OAuth (oauth.yandex.ru → создать приложение) ────────────────────
# Redirect URI приложения: https://DOMAIN/api/auth/yandex/callback
#                        и https://admin.DOMAIN/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# 1 — включить dev-вход без Яндекса (ТОЛЬКО для проверки, в проде держите 0)
AUTH_DEV_FAKE=0

# ── Web Push (сгенерируйте: npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.ru
